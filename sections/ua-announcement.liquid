{%- if section.settings.show and section.blocks.size > 0 -%}
<div class='ua-ann' data-ann data-speed='{{ section.settings.speed }}' role='region' aria-label='Announcements'>
  {%- for b in section.blocks -%}
    <div class='ann-i{% if forloop.first %} on{% endif %}' {{ b.shopify_attributes }}>{%- if b.settings.link != blank -%}<a href='{{ b.settings.link }}'>{{ b.settings.text }}</a>{%- else -%}{{ b.settings.text }}{%- endif -%}</div>
  {%- endfor -%}
</div>
<script>
(function(){
  document.querySelectorAll('[data-ann]').forEach(function(bar){
    if(bar.dataset.init)return;bar.dataset.init='1';
    var items=bar.querySelectorAll('.ann-i'),i=0,ms=(parseInt(bar.dataset.speed,10)||5)*1000,timer;
    if(items.length<2)return;
    function show(n){items[i].classList.remove('on');i=n;items[i].classList.add('on')}
    function start(){timer=setInterval(function(){show((i+1)%items.length)},ms)}
    if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches)start();
    document.addEventListener('shopify:block:select',function(e){var n=Array.prototype.indexOf.call(items,e.target);if(n>-1){clearInterval(timer);show(n)}});
    document.addEventListener('shopify:block:deselect',function(){clearInterval(timer);start()});
  });
})();
</script>
{%- endif -%}

{% schema %}
{"name":"Announcement bar","settings":[{"type":"checkbox","id":"show","label":"Show announcement bar","default":true},{"type":"range","id":"speed","label":"Seconds per message","min":3,"max":10,"step":1,"unit":"s","default":5}],"blocks":[{"type":"message","name":"Message","settings":[{"type":"text","id":"text","label":"Text","default":"Complimentary shipping over ₹2,499"},{"type":"url","id":"link","label":"Link (optional)"}]}],"max_blocks":5,"default":{"blocks":[{"type":"message","settings":{"text":"Complimentary shipping over ₹2,499"}},{"type":"message","settings":{"text":"Easy 15-day returns · COD available"}},{"type":"message","settings":{"text":"Visit us in Lonavala — three stores, open daily"}}]}}
{% endschema %}
