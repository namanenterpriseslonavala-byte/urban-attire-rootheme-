{%- assign s = section.settings -%}
<section class='offer o-{{ s.tone }}' style='--acc:{{ s.accent }}' data-offer data-end='{{ s.end_date | escape }}' data-hide='{{ s.hide_after_end }}'>
  {%- if s.image -%}{{ s.image | image_url: width: 2000 | image_tag: class: 'o-bg', loading: 'lazy', sizes: '100vw', alt: '' }}{%- endif -%}
  <div class='o-in'>
    {%- if s.badge != blank -%}<span class='o-badge'>{{ s.badge }}</span>{%- endif -%}
    <h2>{{ s.heading }}</h2>
    {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
    <div class='o-row'>
      {%- if s.code != blank -%}<button type='button' class='o-code' data-copy='{{ s.code | escape }}' aria-label='Copy code {{ s.code | escape }}'>Code <b>{{ s.code }}</b> <span data-copy-label>Copy</span></button>{%- endif -%}
      {%- if s.btn_label != blank -%}<a class='btn light solid' href='{{ s.btn_link | default: routes.all_products_collection_url }}'>{{ s.btn_label }}</a>{%- endif -%}
    </div>
    {%- if s.show_countdown and s.end_date != blank -%}
      <div class='o-cd' data-cd role='timer' aria-label='Time left for this offer'>
        <div><b data-u='d'>00</b><span>Days</span></div><div><b data-u='h'>00</b><span>Hrs</span></div><div><b data-u='m'>00</b><span>Min</span></div><div><b data-u='s'>00</b><span>Sec</span></div>
      </div>
    {%- endif -%}
    <p class='o-ended' data-ended hidden>This offer has ended.</p>
  </div>
</section>
<script>
(function(){
  document.querySelectorAll('[data-offer]').forEach(function(o){
    if(o.dataset.init)return;o.dataset.init='1';
    var c=o.querySelector('[data-copy]');
    if(c)c.addEventListener('click',function(){var l=c.querySelector('[data-copy-label]'),v=c.getAttribute('data-copy');var ok=function(){l.textContent='Copied';setTimeout(function(){l.textContent='Copy'},1800)};if(navigator.clipboard){navigator.clipboard.writeText(v).then(ok,function(){l.textContent=v})}else{l.textContent=v}});
    var r=(o.getAttribute('data-end')||'').trim();if(!r)return;
    if(r.length===10)r+=' 23:59';r=r.replace(' ','T');if(r.length===16)r+=':00';
    var end=new Date(r+'+05:30').getTime();if(isNaN(end))return;
    var cd=o.querySelector('[data-cd]'),editor=!!(window.Shopify&&Shopify.designMode),t;
    function tick(){
      var ms=end-Date.now();
      if(ms<=0){clearInterval(t);if(o.getAttribute('data-hide')==='true'&&!editor){var w=o.closest('.shopify-section')||o;w.hidden=true}else{if(cd)cd.hidden=true;o.querySelector('[data-ended]').hidden=false}return}
      if(!cd)return;var x=Math.floor(ms/1000),v={d:Math.floor(x/86400),h:Math.floor(x%86400/3600),m:Math.floor(x%3600/60),s:x%60};
      for(var k in v){var b=cd.querySelector('[data-u='+k+']');if(b)b.textContent=String(v[k]).padStart(2,'0')}
    }
    t=setInterval(tick,1000);tick();
  });
})();
</script>

{% schema %}
{"name":"Offer banner","settings":[
{"type":"paragraph","content":"Use for sales, festive offers and launches. Create the discount code first in Shopify admin → Discounts."},
{"type":"text","id":"badge","label":"Badge","default":"Festive edit"},
{"type":"text","id":"heading","label":"Heading","default":"Flat 20% off sitewide"},
{"type":"textarea","id":"text","label":"Text","default":"On shirts, tees and kidswear — online and in all three Lonavala stores."},
{"type":"text","id":"code","label":"Discount code (optional)","default":"FESTIVE20"},
{"type":"text","id":"btn_label","label":"Button label","default":"Shop the offer"},
{"type":"url","id":"btn_link","label":"Button link"},
{"type":"image_picker","id":"image","label":"Background image (optional)"},
{"type":"select","id":"tone","label":"Style","options":[{"value":"dark","label":"Dark"},{"value":"light","label":"Light"},{"value":"accent","label":"Accent colour"}],"default":"dark"},
{"type":"color","id":"accent","label":"Accent colour","default":"#7a2e2a"},
{"type":"header","content":"Countdown"},
{"type":"text","id":"end_date","label":"Offer ends","info":"India time, format YYYY-MM-DD HH:MM — e.g. 2026-11-05 23:59. Leave empty for no end date."},
{"type":"checkbox","id":"show_countdown","label":"Show countdown","default":true},
{"type":"checkbox","id":"hide_after_end","label":"Hide this banner automatically when the offer ends","default":true}
],"presets":[{"name":"Offer banner"}]}
{% endschema %}
