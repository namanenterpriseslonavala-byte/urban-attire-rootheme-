<style>
  .ua-logo{--h:34px;display:inline-flex;align-items:center;gap:0;line-height:1}
  .ua-logo svg{height:var(--h);width:auto;display:block}
  .ua-logo .dv{width:1px;height:calc(var(--h) * .72);background:currentColor;opacity:.5;margin:0 calc(var(--h) * .215) 0 calc(var(--h) * .225)}
  .ua-logo .wm{display:block;border:0;padding:0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:400;text-transform:uppercase;font-size:calc(var(--h) * .345);line-height:1.39;letter-spacing:.38em;margin-right:-.38em;opacity:1}
  .ua-ft .ua-logo{--h:44px}
  @media (max-width:760px){.ua-logo{--h:30px}}
</style>
{% render 'ua-mark' %}<span class='dv' aria-hidden='true'></span><span class='wm'>Urban<br>Attire</span>
